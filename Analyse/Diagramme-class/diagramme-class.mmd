classDiagram
    direction LR

    %% --- Authorization (Spatie RBAC) ---
    class Role {
        -int id
        -String name
        -String guard_name
    }

    class Permission {
        -int id
        -String name
        -String guard_name
    }

    %% --- Actors ---
    class User {
        <<abstract>>
        #int id
        #String name
        #String email
        #String password
    }

    class Client {
        -String phone_number
        -String status
        -float target_goal
        -float current_weight
        -float height
    }

    class Staff {
        -String specialty
        -String bio

    }

    %% Hierarchy
    User <|-- Client
    User <|-- Staff

    %% --- Nutrition Logic ---
    class MealCategory {
        -int id
        -String name
    }

    class Meal {
        -int id
        -int category_id
        -String name
        -String details
        -float protein 
        -float carbs
        -float fats 
        -int calories
    }

    class Program {
        -int id
        -int created_by_staff_id
        -String title
        -Date created_at
    }

    class ProgramItem {
        -int id
        -int program_id
        -int meal_id
        -String day_of_week
        -String time_slot
    }

    %% --- Records ---
    class Evolution {
        -int id
        -int client_id
        -float weight
        -String body_img_url
        -Date recorded_at
    }

    class Payment {
        -int id
        -int client_id
        -double amount
        -Date date
        -String status
    }

    %% --- Relations ---
    
    %% Spatie Logic
    User "*" -- "*" Role
    Role "*" -- "*" Permission

    %% Nutrition Structure
    MealCategory "1" -- "*" Meal : classifies
    Program "1" *-- "*" ProgramItem : contains
    Meal "1" -- "*" ProgramItem : assigned_to
    
    %% Staff Actions
    Staff "1" --> "*" Meal : creates
    Staff "1" --> "*" Program : designs

    %% Client Tracking
    Client "1" -- "0..1" Program : follows
    Client "1" *-- "*" Evolution : tracks
    Client "1" -- "*" Payment : makes