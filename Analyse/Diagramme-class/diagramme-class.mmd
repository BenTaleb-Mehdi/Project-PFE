classDiagram
    direction TB

    %% --- Bibliothèque Maîtresse (Master Data) ---
    class MasterLibrary {
        +getTemplate(id)
        +searchByCategory(tags)
    }

    class ProgramTemplate {
        -string title
        -string goalType (Sèche/Prise)
        -string richTextDescription
        -json metadata
        +cloneToClient(clientId)
    }

    class MealTemplate {
        -string mealName (Ftor/Gheda/...)
        -string richTextInstructions
        -float targetCalories
        -float targetProtein
        -float targetCarbs
        -float targetFats
    }

    %% --- Profil Client Unique (Single Source of Truth) ---
    class ClientProfile {
        -int clientId
        -string currentStatus
        +getFullTimeline()
        +assignProgram(templateId)
    }

    class ActiveProgram {
        -date assignedDate
        -bool isArchived
        -string specificAdjustments
    }

    %% --- Historique & Timeline ---
    class TimelineEvent {
        <<abstract>>
        -datetime timestamp
        -string eventType
    }

    class BiometricRecord {
        -float weight
        -float caloriesConsumed
        -float bodyFat
    }

    class ProgressPhoto {
        -string imageUrl
        -string poseTag (Front/Side/Back)
    }

    %% --- Relations ---
    MasterLibrary "1" *-- "0..*" ProgramTemplate : contient
    ProgramTemplate "1" *-- "1..*" MealTemplate : composé de

    ClientProfile "1" -- "1" ActiveProgram : suit actuellement
    ClientProfile "1" -- "0..*" ProgramTemplate : historique des plans (archives)
    
    ClientProfile "1" *-- "0..*" TimelineEvent : centralise
    TimelineEvent <|-- BiometricRecord
    TimelineEvent <|-- ProgressPhoto
    TimelineEvent <|-- ActiveProgram : (Log d'assignation)

    %% --- Accès Staff ---
    class Staff {
        +string role (Coach/Assistant)
        +accessClientDashboard(id)
    }

    Staff "1..*" -- "1" MasterLibrary : gère
    Staff "1..*" -- "0..*" ClientProfile : supervise