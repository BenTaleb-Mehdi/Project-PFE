classDiagram
    direction LR

    %% --- Actors ---
    class User {
        +int id
        +String name
        +String email
        +String password
    }

    class Client {
        +String phone_number
        +String status
        +float target_goal
        +float current_weight
        +float height
        +DateTime? program_started_at
        +int duration_weeks
    }

    class Staff {
        +String specialty
        +String bio
    }

    %% --- Nutrition Engine ---
    class Meal {
        +int id
        +String name
        +String details
        +float protein 
        +float carbs
        +float fats 
        +int calories
    }

    class MealCategory {
        +int id
        +String name
    }

    class Program {
        +int id
        +String title
    }

    class ProgramItem {
        +int id
        +int day_of_week
        +String time_slot
    }

    %% --- Monitoring & Reporting ---
    class Evolution {
        +int id
        +float weight
        +JSON images
        +DateTime recorded_at
    }

    class Payment {
        +int id
        +float amount
        +DateTime date
        +String status
    }

    %% --- Logical Associations ---
    User "1" -- "0..1" Client : extended_by
    User "1" -- "0..1" Staff : extended_by

    Meal "*" -- "1" MealCategory : categorized_by
    Program "1" *-- "*" ProgramItem : contains
    Meal "1" -- "*" ProgramItem : defined_in

    Staff "1" -- "*" Program : designs
    Client "*" -- "1" Program : follows

    Client "1" *-- "*" Evolution : logs
    Client "1" *-- "*" Payment : pays
