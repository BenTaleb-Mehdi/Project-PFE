classDiagram
    direction LR

    %% --- Authorization (Spatie RBAC) ---
    class Role {
        -int id
        -String name
        -String guard_name
    }

    class Permission {
        -int id
        -String name
        -String guard_name
    }

    %% --- Les Acteurs (Auth & Hierarchy) ---
    class User {
        <<abstract>>
        #int id
        #String nom
        #String email
    }

    class Client {
        -full name
        -phone number
        -email
        -status
        -float goal
        -String Weight
        -String Height
        +updateStats()
    }

    class Staff {
        -String full name
        -String email
        -String role
        -String password
        -String specialite
        +createMeal()
        +generateProgram()
    }

    class Admin {
        +addCoCoach()
        +managePayments()
    }

    %% Hierarchy
    User <|-- Client
    User <|-- Staff
    Staff <|-- Admin

    %% --- Nutrition & Logic (The Workflow) ---
    class MealCategory {
        -int id
        -String name
    }

    class Meal {
        -int id
        -String name
        -String details
        -float protein 
        -float carbs
        -float fats 
    }

    class Program {
        -int id
        -String title
    }

    class ProgramItem {
        -int id
        -int mealId
        -int categoryId
    }

    %% --- Records ---
    class Evolution {
        -float weight
        -String bodyImgUrl
    }

    class Payment {
        -double amount
        -Date date
        -String status
    }

    %% --- Relations ---
    
    %% Spatie Relations
    User "*" -- "*" Role : "model_has_roles"
    User "*" -- "*" Permission : "model_has_permissions"
    Role "*" -- "*" Permission : "role_has_permissions"

    %% 1. Creation Flow
    Staff "1" --> "*" Meal : "crée"
    Staff "1" --> "*" Program : "génère"
    
    %% 2. Program Structure
    MealCategory "1" -- "*" Meal : "contient"
    Program "1" *-- "*" ProgramItem : "composition"
    ProgramItem "n" -- "1" Meal : "sélectionne"

    %% 3. Client Flow
    Client "1" -- "0..1" Program : "suit"
    Client "1" *-- "*" Evolution : "logs"
    Client "1" -- "*" Payment : "paie"
    Admin "1" -- "*" Staff : "gère"